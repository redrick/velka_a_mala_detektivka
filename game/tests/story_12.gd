extends "res://tests/story_test.gd"
## Story 12 "Tajemné šipky" from the chalupa to the end card.


func run() -> void:
	await start("Chalupa12", 12)
	check(Globals.a_intro, "three weeks later at the chalupa")
	await click("Sipka")
	await click("Kulna")
	await click("Dum")
	check(Globals.a_arrow and Globals.a_shed and Globals.a_flour, "the arrow, the shed, the flour")
	await go("Auto", "Ves12")
	check(Globals.a_home, "arrows at home")
	await click("SipkaVysoko")
	await click("SipkaCarkovana")
	await click("SipkaTeckovana")
	await talk("Tonda")
	await click("Garaz")
	check(Globals.a_high and Globals.a_dashed and Globals.a_dotted and Globals.a_tonda and Globals.a_tracks, "street clues")
	await save_and_continue(12, "Ves12")
	check(Globals.a_tracks, "state survives continue")
	await go("Dum", "Chodba12")
	await talk("Mama")
	await click("Schody")
	check(Globals.a_phone and Globals.a_shavings, "máma's list, Hanka's secret")
	await go("Ven", "Ves12")
	await click("Branka")
	check(Globals.a_hurt, "the locked gate")
	await in_room("Chodba12")
	check(Globals.a_morning, "the birthday morning")
	await click("Pokoj")
	check(Globals.a_who, "who drew which arrow")
	if C.player != C.Hanka:
		await talk("Hanka")
	await click("Schody")
	check(Globals.a_tam, "the torch finds TAM")
	await go("Ven", "Ves12")
	await click("Panak")
	check(Globals.a_skoc, "SKOČ")
	await talk("Joey")
	check(Globals.a_joey and Globals.a_arrows, "Joey moves, the arrows put right")
	await go("Branka", "Zahrada12")
	check(Globals.a_seating, "everyone seated")
	await talk("Hanka")
	await talk("Deda")
	await talk("Tata")
	check(Globals.a_hanka and Globals.a_kitten and Globals.a_bike, "the presents")
	await in_room("Menu")
	check(Globals.is_finished(12), "story 12 finished")
