extends "res://tests/story_test.gd"
## Story 5 "Kdo staví sněhuláky?" from the first snow to the end card.


func run() -> void:
	await start("Kuchyne5", 5)
	await in_room("Zahrada5")
	check(Globals.s_day == 1 and C.Alica.sprite_prefix == "alicaw", "morning 1, winter clothes")
	await click("Snehulak")
	check(Globals.s_nose, "the nose is not a carrot")
	await click("Stopy")
	check(Globals.s_stars, "star prints")
	if C.player != C.Hanka:
		await talk("Hanka")
	await click("Diera")
	await in_room("Ves5")
	await click("Koleje")
	await talk("Tonda")
	check(Globals.s_road and Globals.s_tonda, "prints vanish, Tonda suspected")
	await go("Zpet", "Zahrada5")
	await click("Dum")
	await in_room("Zahrada5")
	check(Globals.s_day == 2, "night watch, morning 2")
	await click("Snehulak")
	await click("Nit")
	check(Globals.s_dog and Globals.s_thread, "snow dog, red thread")
	await go("Dum", "Kuchyne5")
	await talk("Babicka")
	check(Globals.s_babicka and Globals.s_mittens, "babička cleared, mittens sorted")
	await save_and_continue(5, "Kuchyne5")
	check(Globals.s_babicka and C.Alica.sprite_prefix == "alicaw", "state and clothes survive continue")
	await go("Dvere", "Zahrada5")
	await go("NaSilnici", "Ves5")
	await talk("Tonda")
	check(Globals.s_tonda_ok, "Tonda cleared")
	await go("DumFranta", "Franta5")
	await click("Pastinak")
	if C.player != C.Hanka:
		await talk("Hanka")
	await click("Boticky")
	await click("Zaves")
	check(Globals.s_parsnip and Globals.s_boots and Globals.s_curtain, "Franta's hallway clues")
	await go("Ven", "Ves5")
	await go("Zpet", "Zahrada5")
	await click("Dum")
	await in_room("Zahrada5")
	check(Globals.s_day == 3, "morning 3")
	await click("Snehulak")
	check(Globals.s_mitten and Globals.s_who and Globals.s_answer and has_item("Rukavicka"), "mitten, letter, who, answer")
	await click("Dum")
	await in_room("Zahrada5")
	check(Globals.s_day == 4 and R.current.has_character("Betka"), "morning 4: Bětka")
	if C.player != C.Hanka:
		await talk("Hanka")
	await talk("Betka")
	check(Globals.s_betka, "met Bětka")
	await in_room("Menu")
	check(Globals.is_finished(5), "story 5 finished")
