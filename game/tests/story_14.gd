extends "res://tests/story_test.gd"
## Story 14 "Poklad na hradě" from the gate to the end card.


func run() -> void:
	await start("Brana14", 14)
	check(Globals.h_intro, "the Klub at the gate")
	await click("Klicek1")
	check(Globals.h_found == 2, "a hidden key found")
	await talk("Kastelanka")
	await in_room("Nadvori14")
	check(Globals.h_keys and Globals.h_court, "the keys, the rohlík on the bench")
	await click("Okna")
	await click("Lavicka")
	await click("Vez")
	check(Globals.h_rohlik, "hunting 14, the rohlík is gone")
	await go("Brana", "Brana14")
	await click("Prikop")
	check(Globals.h_bears, "the bears can't get out")
	await go("Brana", "Nadvori14")
	await go("Sal", "Sal14")
	check(Globals.h_evening and C.player == C.Hanka, "evening, night, Hanka's torch")
	await click("Okno")
	check(Globals.h_night, "the rustling, morning")
	await save_and_continue(14, "Sal14")
	await click("Okno")
	check(Globals.h_sill, "prints and a black feather")
	await talk("Kastelanka")
	check(Globals.h_kastel, "the kastelánka cleared")
	await go("Dvere", "Nadvori14")
	await click("Vetvicky")
	await talk("Betka")
	check(Globals.h_twigs and Globals.h_drawing and C.player == C.Hanka, "twigs, drawing, dawn")
	await click("Oci")
	check(Globals.h_dawn and Globals.h_who, "eyes and the ribbon, who")
	await talk("Kastelanka")
	check(Globals.h_quiz, "jackdaw facts and quiz")
	await talk("Betka")
	check(Globals.h_count, "the 14th hole")
	await click("Zebrik")
	check(Globals.h_hole and Globals.h_name, "Hanka's hand, Kája")
	await click("Plechovka")
	await in_room("Menu")
	check(Globals.is_finished(14), "story 14 finished")
