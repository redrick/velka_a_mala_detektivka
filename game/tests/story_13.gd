extends "res://tests/story_test.gd"
## Story 13 "Stopy u potoka" from the camp to the end card.


func run() -> void:
	await start("Louka13", 13)
	check(Globals.b_intro, "the camp")
	await click("Zaba1")
	check(Globals.b_frogs == 2, "a frog found")
	await go("Potok", "Potok13")
	await talk("Betka")
	check(Globals.b_rock1, "Bětka's first drawing")
	await click("Kameny")
	await go("Louka", "Louka13")
	await click("Ohen")
	check(Globals.b_evening and has_item("Klacik"), "the evening, Hanka's stick")
	check(C.player == C.Hanka, "Hanka has the torch")
	await click("Vrby")
	check(Globals.b_night1 and Globals.b_day == 2, "PLESK, morning")
	await click("Vrba")
	await talk("Deda")
	check(Globals.b_stump and Globals.b_stick, "the stump and the stick")
	await save_and_continue(13, "Louka13")
	check(Globals.b_stump, "state survives continue")
	await click("Polena")
	if C.player == C.Alica:
		await talk("Hanka")
	else:
		await talk("Alica")
	await talk("Joey")
	check(Globals.b_saw and Globals.b_knife and Globals.b_joey and Globals.b_cuts, "suspects checked, cuts matched")
	await go("Potok", "Potok13")
	await talk("Rybar")
	await talk("Betka")
	check(Globals.b_franta and Globals.b_rock2, "Franta, drawing 2")
	await click("Stopy")
	check(Globals.b_tracks, "the webbed prints, the stake-out")
	await click("Oci")
	check(Globals.b_night2 and Globals.b_day == 3, "eyes, PLESK, morning")
	await click("Pahyl")
	await talk("Betka")
	check(Globals.b_stump2 and Globals.b_rock and Globals.b_who, "stump 2, drawings, who")
	await go("Hraz", "Hraz13")
	check(Globals.b_dam, "the dam")
	await talk("Hajny")
	check(Globals.b_hajny and Globals.b_quiz and Globals.b_damgame, "hajný, quiz, dam")
	await click("Plave")
	check(Globals.b_beaver, "Hryzálek")
	await use("Klacik", "Bobr")
	check(Globals.b_gift, "the gift")
	await click("Plechovka")
	await in_room("Menu")
	check(Globals.is_finished(13), "story 13 finished")
