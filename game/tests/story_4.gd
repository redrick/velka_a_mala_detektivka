extends "res://tests/story_test.gd"
## Story 4 "Hanka to vyřeší!" from the start to the end card.


func run() -> void:
	await start("Pokoj4", 4)
	check(C.player == C.Hanka, "Hanka plays")
	check(Globals.f_intro and has_item("Vysilacka"), "intro: walkie-talkie")
	await go("Dvere", "Ves4")
	await click("Kurnik")
	check(Globals.f_kurnik, "new henhouse checked")
	await click("StaryKurnik")
	check(Globals.f_inside and R.current.get_prop("Stopy").visible, "old henhouse: hen, star, F, prints")
	await click("Stopy")
	check(Globals.f_prints, "prints reported")
	await click("Hodiny")
	check(Globals.f_three, "three o'clock: the hand points THERE")
	await go("KPoli", "Pole4")
	await click("Straka")
	await click("Kamen1")
	await click("Potok")
	await click("Kamen3")
	await in_room("Ves4")
	check(Globals.f_evening, "evening suspects at Alica's bed, then the next morning")
	await talk("Kostelnik")
	check(Globals.f_tower, "sexton cleared, view from the tower")
	await save_and_continue(4, "Ves4")
	check(Globals.f_tower and C.player == C.Hanka, "state survives save + continue")
	await go("KPoli", "Pole4")
	await click("Bota")
	check(Globals.f_radio, "radioed through the rocks")
	check(Globals.f_bota and R.current.is_dark(), "at the Bota, dusk")
	await click("Skulina")
	check(Globals.f_tin and has_item("Plechovka"), "the tin")
	await go("DoVsi", "Ves4")
	await go("Domu", "Pokoj4")
	await talk("Alica")
	check(Globals.f_opened and Globals.f_who and Globals.f_read, "tin opened, who was it, new letter read")
	check(has_item("KlicHodin") and has_item("NovyDopis"), "key and new letter")
	await go("Dvere", "Ves4")
	await go("KPoli", "Pole4")
	await go("KRybniku", "Molo4")
	await talk("Rybar")
	check(Globals.f_franta, "Franta found")
	await go("Zpet", "Pole4")
	await go("DoVsi", "Ves4")
	await click("Hodiny")
	check(Globals.f_clock, "the clock runs")
	await in_room("Menu")
	check(Globals.is_finished(4), "story marked finished")
